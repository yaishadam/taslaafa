# Supabase — project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# HKDF derives the MAC and AES keys from this. It must NEVER be stored in the
# database: that is the whole reason a dump cannot reveal a 4-digit code.
# Rotating it makes every unconfirmed code unreadable and unverifiable.
TASLAAFA_CODE_KEY=

# Public origin used to build the /d/[token] links that go into Viber/WhatsApp
NEXT_PUBLIC_APP_ORIGIN=https://taslaafa.app

# Password shared by every account the seed creates. Any value you like --
# it must not be committed, which is why it lives here and not in seed.mts.
SEED_PASSWORD=

# Shared secret for the Vercel cron route
CRON_SECRET=
